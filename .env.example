DATABASE_URL="file:./dev.db"
PORT=3001

# Optional: contact for MusicBrainz requests; defaults to the project URL
# MUSICBRAINZ_USER_AGENT="Sleeve (you@example.com)"

# Optional: host port for Docker Compose; the container keeps listening on 3001
# SLEEVE_PORT=3001

# Optional: image tag for docker-compose.image.yml; defaults to latest
# SLEEVE_VERSION=0.1.0

# Optional: self-host paths
# DATA_DIR=./data
# COVER_CACHE_MAX_MB=500
# AUTO_MIGRATE=true
# BACKUP_DIR=./data/backups

# Optional: HTTP Basic auth for exposed deployments
# SLEEVE_AUTH_USER=
# SLEEVE_AUTH_PASSWORD=
