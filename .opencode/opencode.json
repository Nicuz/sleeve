{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "prisma/dev.db*", "effect": "deny" },
    { "action": "edit", "resource": "data/*", "effect": "deny" },
    { "action": "edit", "resource": ".env", "effect": "deny" },
    { "action": "edit", "resource": ".env.*", "effect": "deny" },
    { "action": "edit", "resource": ".env.example", "effect": "allow" },
    { "action": "shell", "resource": "bun run seed -- --reset", "effect": "deny" },
    { "action": "shell", "resource": "bun run seed --reset", "effect": "deny" }
  ],
  "agents": {
    "reviewer": {
      "description": "Review Sleeve changes without editing files",
      "mode": "subagent",
      "permissions": [{ "action": "edit", "resource": "*", "effect": "deny" }]
    }
  }
}
