{
  "name": "sleeve",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"bun --watch server/index.ts\" \"vite\"",
    "dev:api": "bun --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "start": "NODE_ENV=production bun server/index.ts",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "seed": "bun prisma/seed.ts",
    "lint": "biome check src server prisma/seed.ts scripts vite.config.ts",
    "format": "biome check --write src server prisma/seed.ts scripts vite.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "backup": "bun scripts/backup.ts",
    "restore": "bun scripts/restore.ts",
    "test": "bun test",
    "test:docker": "bash scripts/test-docker.sh",
    "sample": "bun scripts/sample-data.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "elysia": "1.4.31",
    "lucide-react": "^1.70.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@happy-dom/global-registrator": "^21.0.4",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "happy-dom": "^21.0.4",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9.3",
    "vite": "^8.3.7"
  }
}
