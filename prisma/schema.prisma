generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Release {
  id               String   @id @default(cuid())
  musicbrainzId    String?  @unique
  title            String
  artist           String
  artistId         String?
  year             Int?
  releaseDate      String?
  country          String?
  label            String?
  catalogNumber    String?
  barcode          String?
  format           String
  formatDetail     String?
  coverUrl         String?
  notes            String?
  rating           Int?
  condition        String?
  purchaseDate     String?
  purchaseLocation String?
  purchasePrice    Float?
  purchaseCurrency String?
  genres           String?
  trackCount       Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tracks Track[]

  @@index([artist])
  @@index([format])
  @@index([year])
  @@index([createdAt])
}

model WishlistItem {
  id             String   @id @default(cuid())
  musicbrainzId  String?  @unique
  releaseGroupId String?  @unique
  title          String
  artist         String
  artistId       String?
  year           Int?
  releaseDate    String?
  country        String?
  label          String?
  catalogNumber  String?
  barcode        String?
  format         String
  formatDetail   String?
  coverUrl       String?
  notes          String?
  targetPrice    Float?
  targetCurrency String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
}

model SavedSuggestion {
  id             String   @id @default(cuid())
  releaseGroupId String   @unique
  title          String
  artist         String
  artistId       String?
  year           Int?
  releaseDate    String?
  coverUrl       String?
  type           String
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model ArtistFollow {
  artistId  String   @id
  name      String
  createdAt DateTime @default(now())

  @@index([name])
}

model MetadataCache {
  key       String   @id
  payload   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model DiscoveryFeed {
  id          String   @id @default("current")
  payload     String
  generatedAt DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

model DiscoverySeen {
  releaseGroupId String   @id
  artistId       String?
  seenAt         DateTime @default(now())

  @@index([seenAt])
}

model DiscoveryEvent {
  id             String   @id @default(cuid())
  releaseGroupId String
  artistId       String?
  artist         String?
  action         String
  createdAt      DateTime @default(now())

  @@index([releaseGroupId])
  @@index([artistId])
  @@index([createdAt])
}

model Track {
  id        String  @id @default(cuid())
  releaseId String
  position  Int
  disc      Int?
  number    Int?
  title     String
  duration  Int?
  artist    String?

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId])
}
